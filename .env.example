# Copy this file to .env and paste your key (https://console.anthropic.com/settings/keys).
# .env is git-ignored. Without a key the game still works; the curator just falls back
# to retrieval-only replies.
ANTHROPIC_API_KEY=...
# Optional overrides:
# CURATOR_MODEL=claude-haiku-5-5
# CURATOR_MAX_CALLS=300
